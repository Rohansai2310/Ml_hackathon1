{
  "candidate_radius_m": 75.0,
  "max_candidates": 40,
  "window": 3,
  "feature_columns": [
    "dist_m",
    "frac_along",
    "arc_len_m",
    "dist_rank",
    "dist_rel_min",
    "n_cand",
    "heading_diff_deg",
    "cos_heading",
    "speed_mps",
    "dt_prev",
    "dt_next",
    "win_mean_dist",
    "win_max_dist",
    "win_min_dist",
    "win_hit_frac",
    "out_deg_to",
    "in_deg_from",
    "has_reverse",
    "to_node_dist_m",
    "from_node_dist_m",
    "along_advance_m",
    "speed_dist_resid"
  ],
  "label_max_dist_m": 50.0,
  "seed": 42,
  "n_folds": 5,
  "target": "label (1 if candidate arc == aligned reference arc of that GPS point)",
  "use_rows_where": "label_valid == True (training/CV: also fold >= 0)"
}